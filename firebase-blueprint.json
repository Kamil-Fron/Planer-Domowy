{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with reference to active household and personal settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User Firebase UID"
        },
        "name": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "avatarUrl": {
          "type": "string",
          "description": "User profile picture URL"
        },
        "activeHouseholdId": {
          "type": "string",
          "description": "Active household ID"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login timestamp"
        }
      },
      "required": ["id", "email"]
    },
    "Household": {
      "title": "Household",
      "description": "A shared household budget and planner workspace containing transactions, bills, limits and shopping items",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Household unique identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Name of the household",
          "maxLength": 100
        },
        "inviteCode": {
          "type": "string",
          "description": "Invitation code for family members",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO date"
        },
        "createdBy": {
          "type": "string",
          "description": "Creator identifier or email",
          "maxLength": 100
        },
        "members": {
          "type": "array",
          "description": "List of household members"
        },
        "transactions": {
          "type": "array",
          "description": "List of household transactions"
        },
        "bills": {
          "type": "array",
          "description": "List of recurring bills"
        },
        "budgetLimits": {
          "type": "array",
          "description": "Budget category limits"
        },
        "shoppingLists": {
          "type": "array",
          "description": "Shopping lists"
        },
        "shoppingItems": {
          "type": "array",
          "description": "Shopping list items"
        },
        "lastUpdatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        },
        "lastUpdatedBy": {
          "type": "string",
          "description": "User who made the latest change",
          "maxLength": 100
        }
      },
      "required": ["id", "name", "inviteCode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing user details and their active household"
    },
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Household document storage for real-time family budget synchronization"
    }
  }
}
